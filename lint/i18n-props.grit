language js

or {
  JsxAttribute() as $attr where {
    $attr <: r"(?s)(?:aria-label|title|placeholder|alt|label|description)=(?:\"|\{\s*[\"'`]).*\p{L}.*",
    register_diagnostic(span=$attr, message="Untranslated text in a user-facing prop. Use m.key() from #/paraglide/messages.js.", severity="error")
  },
  JsCallExpression(callee=$callee, arguments=$args) where {
    $callee <: r"toast(?:\.\w+)?",
    $args <: JsCallArguments(args=$list),
    $list <: some $msg,
    $msg <: or {
      JsStringLiteralExpression(),
      JsTemplateExpression()
    },
    $msg <: r"(?s).*\p{L}.*",
    register_diagnostic(span=$msg, message="Untranslated toast message. Use m.key() from #/paraglide/messages.js.", severity="error")
  }
}
